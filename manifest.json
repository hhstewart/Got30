{
  "manifest_version": 3,
  "name": "Got 30?",
  "short_name": "Got 30?",
  "version": "1.0.0",
  "description": "Write short cold networking emails that get replies, and track everyone you reach out to.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Got 30?", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel"]
}
